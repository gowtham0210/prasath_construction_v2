# Enquiry form endpoint. Default "/api/enquiry" is served by `npm run server` (see server/index.mjs).
# You can also point this at a hosted form service (Formspree, Web3Forms, a Netlify/Vercel function, …).
VITE_FORM_ENDPOINT=/api/enquiry

# Company details (all optional — empty values are hidden on the site)
VITE_COMPANY_EMAIL=
VITE_COMPANY_PHONE=
VITE_COMPANY_ADDRESS=
VITE_SERVICE_AREAS=
# WhatsApp number, digits only with country code, e.g. 919876543210
VITE_WHATSAPP_NUMBER=
# Public URL of the deployed site (used for canonical/OG/sitemap)
VITE_SITE_URL=https://example.com
